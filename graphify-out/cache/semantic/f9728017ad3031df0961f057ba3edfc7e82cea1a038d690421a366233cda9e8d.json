{"nodes": [{"id": "agents_cafemin_task_tracker", "label": "CAFEMIN Task Tracker (Project)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "Project Overview", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_role_system", "label": "Three-Role System (Administrador/Gestor/Asignado)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "Role system", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_administrador_role", "label": "Administrador Role", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "Role system table", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_gestor_role", "label": "Gestor Role", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "Role system table", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_asignado_role", "label": "Asignado Role", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "Role system table", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_three_level_role_guards", "label": "Three-Level Role Guards (RLS + DB Trigger + Client)", "file_type": "rationale", "rationale": "Defense in depth: Supabase RLS is the authoritative boundary, trg_restrict_asignado_update enforces column-level restrictions, and client guards in App.jsx/KanbanBoard.jsx only prevent rendering unauthorized UI.", "source_file": "AGENTS.md", "source_location": "Role system", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_trg_restrict_asignado_update", "label": "trg_restrict_asignado_update Trigger", "file_type": "concept", "rationale": "Enforces at DB level that Asignado can only modify estado and evidencia_url; when adding new updatable columns for Asignado the trigger's exclusion list must be updated.", "source_file": "AGENTS.md", "source_location": "Database schema", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_trg_fecha_hecho", "label": "trg_fecha_hecho Trigger", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "Database schema", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_on_auth_user_created_trigger", "label": "on_auth_user_created Trigger", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "Database schema", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_get_my_role_function", "label": "get_my_role() Security-Definer Function", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "Database schema", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_asignado_update_own_task_policy", "label": "Asignado Update Own Task RLS Policy", "file_type": "concept", "rationale": "The policy needs both USING and WITH CHECK clauses; removing WITH CHECK would allow an Asignado to self-reassign tasks.", "source_file": "AGENTS.md", "source_location": "Database schema / Security guidance", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_evidencias_bucket", "label": "evidencias Storage Bucket", "file_type": "concept", "rationale": "The bucket is public because getPublicUrl requires it; access is still constrained by explicit INSERT/SELECT/DELETE RLS policies, and the public URL is stored in tareas.evidencia_url.", "source_file": "AGENTS.md", "source_location": "Storage", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_dark_mode_strategy", "label": "Dark Mode Strategy (Tailwind class + localStorage)", "file_type": "rationale", "rationale": "Tailwind darkMode:'class' toggled on <html> by App.jsx; preference read lazily from localStorage falling back to prefers-color-scheme; DOM sync lives in a useEffect (not the state setter) as the correct React pattern.", "source_file": "AGENTS.md", "source_location": "Dark mode", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_anti_flash_script", "label": "Anti-Flash Dark Mode Script", "file_type": "rationale", "rationale": "An inline script in index.html applies the dark class before React hydrates, preventing a white flash on page load.", "source_file": "AGENTS.md", "source_location": "Dark mode", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_kanban_board", "label": "Kanban Board (Drag-and-Drop, All Roles)", "file_type": "concept", "rationale": "Applies optimistic state updates on drag-end for responsiveness, with Realtime confirming the persisted state afterward; the Realtime channel name is unique per component instance (kanban-tareas-${useId()}) to prevent duplicate subscriptions on rapid unmount/remount; Admin/Gestor cards use a drag handle so buttons stay clickable, while Asignado cards are fully draggable.", "source_file": "AGENTS.md", "source_location": "Kanban board", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_forward_only_transitions", "label": "Forward-Only Status Transitions for Asignado", "file_type": "concept", "rationale": "Asignado may only drag Pendiente to En curso to Hecho; dragging backward from Hecho is blocked in handleDragEnd, so reopening requires Admin/Gestor.", "source_file": "AGENTS.md", "source_location": "Kanban board", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_photo_evidence_gate", "label": "Photo Evidence Gate (PhotoModal before Hecho)", "file_type": "concept", "rationale": "If foto_requerida = true and the user is Asignado, dropping on Hecho opens a PhotoModal before persisting; Admin/Gestor bypass the gate.", "source_file": "AGENTS.md", "source_location": "Kanban board", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_transient_supabase_client", "label": "Transient Supabase Client for User Creation", "file_type": "rationale", "rationale": "UserManagement.jsx creates users with a transient client (persistSession: false, autoRefreshToken: false) so signUp does not overwrite the Admin's session in localStorage; the profile row created by on_auth_user_created is then updated with the selected role.", "source_file": "AGENTS.md", "source_location": "User creation", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_auth_initialization_pattern", "label": "Auth Init via onAuthStateChange Only", "file_type": "rationale", "rationale": "Auth initialization uses onAuthStateChange exclusively (no getSession) because INITIAL_SESSION fires synchronously, avoiding a concurrent double-fetch race on the profile.", "source_file": "AGENTS.md", "source_location": "Security & resilience guidance", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_state_based_view_routing", "label": "State-Based View Routing (No React Router)", "file_type": "concept", "rationale": "State-based navigation via currentView in App.jsx is intentional; each view maps to a component with role restrictions (tasks/form/reports/users/catalogs).", "source_file": "AGENTS.md", "source_location": "View routing", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_tasklist_deprecated", "label": "TaskList.jsx Kept for Reference (Deprecated)", "file_type": "rationale", "rationale": "TaskList.jsx is no longer in the main navigation flow because all roles now use KanbanBoard; it is retained for reference and can be removed in a cleanup.", "source_file": "AGENTS.md", "source_location": "Notes for future agents", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "agents_administrador_role", "target": "agents_role_system", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": "Role system table", "weight": 1.0}, {"source": "agents_gestor_role", "target": "agents_role_system", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": "Role system table", "weight": 1.0}, {"source": "agents_asignado_role", "target": "agents_role_system", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": "Role system table", "weight": 1.0}, {"source": "agents_cafemin_task_tracker", "target": "agents_role_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": "Project Overview", "weight": 1.0}, {"source": "agents_cafemin_task_tracker", "target": "agents_state_based_view_routing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": "View routing", "weight": 1.0}, {"source": "agents_cafemin_task_tracker", "target": "agents_kanban_board", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": "Kanban board", "weight": 1.0}, {"source": "agents_three_level_role_guards", "target": "agents_trg_restrict_asignado_update", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": "Role system (guard level 2)", "weight": 1.0}, {"source": "agents_trg_restrict_asignado_update", "target": "agents_asignado_role", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": "Database schema", "weight": 1.0}, {"source": "agents_asignado_u