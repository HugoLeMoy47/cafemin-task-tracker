# Proyecto de Supabase / Supabase project
VITE_SUPABASE_URL=https://your-project.supabase.co

# Clave PUBLICA del proyecto. Usa una de las dos, no ambas.
# Project PUBLIC key. Use one of the two, not both.
#   - Clave nueva / new key      -> sb_publishable_...
#   - Clave heredada / legacy    -> JWT que empieza con eyJ...
# NUNCA pongas aqui service_role, sb_secret_... ni cadenas de conexion a
# Postgres: estas variables se hornean en el JavaScript publico.
# NEVER put service_role, sb_secret_... or Postgres connection strings here:
# these variables are baked into the public JavaScript bundle.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
# VITE_SUPABASE_ANON_KEY=your-legacy-anon-key-here

# Modo demostración: "true" en el despliegue público, vacío en local.
# Muestra el aviso de ambiente de demo y oculta el registro de usuarios.
# Demo mode: "true" on the public deployment, empty locally.
VITE_DEMO_MODE=
