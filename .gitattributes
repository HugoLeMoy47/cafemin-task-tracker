# Normalización de fin de línea / Line-ending normalization
# Evita diffs falsos entre Windows (CRLF) y Linux/macOS (LF).
# Prevents phantom diffs between Windows (CRLF) and Linux/macOS (LF).
* text=auto eol=lf

# Archivos que deben conservar CRLF en Windows / Files that must keep CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binarios: nunca normalizar / Binaries: never normalize
*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.woff      binary
*.woff2     binary

# Excluir ruido del diff en revisiones / Keep noise out of code reviews
package-lock.json  -diff linguist-generated
